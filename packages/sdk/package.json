{
  "name": "@kisaes/vibe-ai-client",
  "version": "0.2.3",
  "description": "Typed client for the Vibe AI Router — the only way Vibe apps talk to AI",
  "license": "PolyForm-Small-Business-1.0.0",
  "author": "KisaesDevLab",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -w exec vitest run test/sdk",
    "prepare": "node -e \"const fs=require('fs');if(fs.existsSync('tsconfig.json')&&fs.existsSync('src'))require('child_process').execSync('tsc -p tsconfig.json',{stdio:'inherit'})\""
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
